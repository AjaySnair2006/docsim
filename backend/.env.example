# Copy this file to `.env` and fill in real values. Never commit `.env`.

APP_NAME=AI Document Similarity Detection System
APP_VERSION=1.0.0
DEBUG=True

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Folders (relative to backend/) used for temp uploads and generated reports
UPLOAD_DIR=uploads
REPORT_DIR=reports

# Upload validation
MAX_FILE_SIZE_MB=10

# Similarity threshold (0-1) above which two pages are flagged as "similar"
SIMILARITY_THRESHOLD=0.75

# Sentence-transformer model and minimum cosine similarity for semantic page matches
CONTENT_SIMILARITY_MODEL=sentence-transformers/all-MiniLM-L6-v2
CONTENT_SIMILARITY_THRESHOLD=0.45

# API key for the AI/ML similarity module, if it calls an external API
AI_MODULE_API_KEY=
